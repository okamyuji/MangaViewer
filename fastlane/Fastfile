default_platform(:mac)

platform :mac do
  desc "Generate Xcode project from project.yml"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Run macOS unit and UI tests"
  lane :test do
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer -configuration Debug test")
  end

  desc "Run unit and UI tests on the first available iPad simulator"
  lane :ipad_test do
    require "json"
    runtimes = JSON.parse(sh("xcrun simctl list devices available -j", log: false))["devices"]
    # Runtime keys look like com.apple.CoreSimulator.SimRuntime.iOS-27-0; the app needs iOS 17 or later
    ios_version = ->(runtime) { runtime[/iOS-(\d+)-(\d+)/] ? [$1.to_i, $2.to_i] : nil }
    ipad = runtimes.select { |runtime, _| (ios_version.call(runtime) || [0])[0] >= 17 }
                   .sort_by { |runtime, _| ios_version.call(runtime) }.reverse
                   .flat_map { |_, devices| devices }
                   .find { |device| device["name"].start_with?("iPad") }
    UI.user_error!("No iPad simulator is available") unless ipad
    # On a loaded runner the simulator now and then takes over a minute to hand a fresh launch to XCTest,
    # so a failed test is retried (up to 3 runs in all); a real failure fails every run. The result bundle is kept for CI to upload.
    sh("cd .. && rm -rf build/ipad-tests.xcresult && " \
       "xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer-iPad -configuration Debug " \
       "-destination 'platform=iOS Simulator,id=#{ipad['udid']}' " \
       "-retry-tests-on-failure -resultBundlePath build/ipad-tests.xcresult test")
  end

  desc "Run linter and formatter checks"
  lane :lint do
    sh("cd .. && swiftlint lint --quiet")
    sh("cd .. && swiftformat --lint .")
    sh("cd .. && sh scripts/stamp-version.test.sh")
  end

  desc "Build release"
  lane :build do
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer -configuration Release build")
    # The iPad app in its Release configuration; a simulator build needs no signing identity
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer-iPad -configuration Release " \
       "-destination 'generic/platform=iOS Simulator' build")
  end

  desc "Archive for App Store"
  lane :archive do
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer -configuration Release archive -archivePath build/MangaViewer.xcarchive")
  end

  desc "Full CI pipeline: generate, lint, test (macOS and iPad), build"
  lane :ci do
    generate
    lint
    test
    ipad_test
    build
  end
end
