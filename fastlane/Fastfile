default_platform(:mac)

platform :mac do
  desc "Generate Xcode project from project.yml"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Run tests"
  lane :test do
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewerTests -configuration Debug test")
  end

  desc "Run unit and UI tests on the first available iPad simulator"
  lane :ipad_test do
    require "json"
    runtimes = JSON.parse(sh("xcrun simctl list devices available -j", log: false))["devices"]
    # Runtime keys look like com.apple.CoreSimulator.SimRuntime.iOS-27-0; the app needs iOS 17 or later
    ios_version = ->(runtime) { runtime[/iOS-(\d+)-(\d+)/] ? [$1.to_i, $2.to_i] : nil }
    ipad = runtimes.select { |runtime, _| (ios_version.call(runtime) || [0])[0] >= 17 }
                   .sort_by { |runtime, _| ios_version.call(runtime) }.reverse
                   .flat_map { |_, devices| devices }
                   .find { |device| device["name"].start_with?("iPad") }
    UI.user_error!("No iPad simulator is available") unless ipad
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer-iPad -configuration Debug " \
       "-destination 'platform=iOS Simulator,id=#{ipad['udid']}' test")
  end

  desc "Run linter and formatter checks"
  lane :lint do
    sh("cd .. && swiftlint lint --quiet")
    sh("cd .. && swiftformat --lint .")
  end

  desc "Build release"
  lane :build do
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer -configuration Release build")
  end

  desc "Archive for App Store"
  lane :archive do
    sh("cd .. && xcodebuild -project MangaViewer.xcodeproj -scheme MangaViewer -configuration Release archive -archivePath build/MangaViewer.xcarchive")
  end

  desc "Full CI pipeline: generate, lint, test (macOS and iPad), build"
  lane :ci do
    generate
    lint
    test
    ipad_test
    build
  end
end
